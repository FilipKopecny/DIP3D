# Port sources: normalise line endings
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.md      text eol=lf
*.cmd     text eol=crlf

# Lumina.ani is generated by Port/tools/Lumina (8.9 MB): keep it byte-exact, and don't diff it
Port/samples/**/*.ani  -text -diff

# The 1998 material is archival: keep every byte as it was on the CD
# (Windows-1250 text, CRLF, Borland project files)
DIP/**    -text -diff
DIP/**/*.cpp  diff
DIP/**/*.h    diff
DIP/**/*.ani  diff

# Binary formats
*.bmp  binary
*.BMP  binary
*.png  binary
*.jpg  binary
*.doc  binary
*.rar  binary
*.res  binary
