<Window x:Class="Overbryce.App.UI.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Overbryce.App.UI"
        Style="{DynamicResource {x:Type Window}}"
        Title="Overbryce Animator" Width="1280" Height="800" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <!--
        Main window (original TAniMain): element tree and properties on the left, the OpenGL view with
        the move/rotate tools on the right, the key-state timeline below. Menu shortcuts are the
        InputGestureText of the menu items (MainWindow.xaml.cs reads them).
    -->

    <DockPanel x:Name="Root">

        <!-- ============================================================ menu -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="New_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8A5;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="Open_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE838;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE74E;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE792;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Export frames..." InputGestureText="Ctrl+E" Click="Export_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE714;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Rendering se_ttings..." Click="RenderSettings_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE713;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem x:Name="InsertMenu" Header="_Insert" />
                <MenuItem Header="_Delete" InputGestureText="Del" Click="Delete_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE74D;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Re_name" InputGestureText="F2" Click="Rename_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8AC;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Set as active _camera" InputGestureText="Ctrl+K" Click="ActiveCamera_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE722;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="D_uplicate key state" InputGestureText="Ctrl+D" Click="DuplicateState_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8C8;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Delete key s_tate" InputGestureText="Ctrl+Del" Click="DeleteState_Click" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem x:Name="WireItem" Header="_Wire frame" InputGestureText="Ctrl+W" IsCheckable="False" Click="Wire_Click" />
                <MenuItem x:Name="ModernItem" Header="_Modern rendering" InputGestureText="Ctrl+M" Click="Modern_Click" />
                <MenuItem Header="_Ray trace this view" InputGestureText="F9" Click="RayTrace_Click">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RayTrace}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="CameraViewItem" Header="_Camera" InputGestureText="Ctrl+1" Tag="Camera" Click="ViewMode_Click" />
                <MenuItem x:Name="FrontViewItem" Header="_Front" InputGestureText="Ctrl+2" Tag="Front" Click="ViewMode_Click" />
                <MenuItem x:Name="SideViewItem" Header="_Side" InputGestureText="Ctrl+3" Tag="Side" Click="ViewMode_Click" />
                <MenuItem x:Name="TopViewItem" Header="_Top" InputGestureText="Ctrl+4" Tag="Top" Click="ViewMode_Click" />
                <Separator />
                <MenuItem Header="F_irst key state" InputGestureText="Ctrl+Home" Click="FirstState_Click" />
                <MenuItem Header="_Previous key state" InputGestureText="PgUp" Click="PreviousState_Click" />
                <MenuItem Header="_Next key state (new at end)" InputGestureText="PgDn" Click="NextState_Click" />
                <MenuItem Header="_Last key state" InputGestureText="Ctrl+End" Click="LastState_Click" />
                <Separator />
                <MenuItem Header="T_heme">
                    <MenuItem x:Name="ThemeSystemItem" Header="Follow _Windows" Tag="System" Click="Theme_Click" />
                    <MenuItem x:Name="ThemeLightItem" Header="_Light" Tag="Light" Click="Theme_Click" />
                    <MenuItem x:Name="ThemeDarkItem" Header="_Dark" Tag="Dark" Click="Theme_Click" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Animation">
                <MenuItem Header="_Settings..." Click="AnimationSettings_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE713;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Modern rendering settings..." Click="ModernSettings_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE706;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Ray tracing settings..." Click="RaytraceSettings_Click">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RayTrace}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Play / Stop" InputGestureText="F5" Click="Play_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE768;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Compute frames (export)..." Click="Export_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE714;" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_Controls" InputGestureText="F1" Click="Help_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE897;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_About" Click="About_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE946;" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ============================================================ tool bar -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="4,2">
            <WrapPanel>
                <Button Style="{StaticResource ToolButton}" ToolTip="New (Ctrl+N)" Click="New_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Open (Ctrl+O)" Click="Open_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTip="Save (Ctrl+S)" Click="Save_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                </Button>
                <Border Style="{StaticResource ToolSeparator}" />

                <!-- one button per element type (MainWindow.xaml.cs) -->
                <StackPanel x:Name="InsertButtons" Orientation="Horizontal" />
                <ToggleButton x:Name="MeshPresetsButton" Style="{StaticResource ToolToggle}" ToolTip="Insert a Bezier mesh preset" Click="MeshPresets_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Mesh}" />
                        <TextBlock Style="{StaticResource Glyph}" FontSize="8" Margin="3,0,0,0" Text="&#xE70D;" />
                    </StackPanel>
                </ToggleButton>
                <Border Style="{StaticResource ToolSeparator}" />

                <ToggleButton x:Name="CameraViewButton" Style="{StaticResource ToolTextToggle}" Content="Camera" Tag="Camera" ToolTip="Through the active camera (Ctrl+1)" Click="ViewMode_Click" />
                <ToggleButton x:Name="FrontViewButton" Style="{StaticResource ToolTextToggle}" Content="Front" Tag="Front" ToolTip="Front view (Ctrl+2)" Click="ViewMode_Click" />
                <ToggleButton x:Name="SideViewButton" Style="{StaticResource ToolTextToggle}" Content="Side" Tag="Side" ToolTip="Side view (Ctrl+3)" Click="ViewMode_Click" />
                <ToggleButton x:Name="TopViewButton" Style="{StaticResource ToolTextToggle}" Content="Top" Tag="Top" ToolTip="Top view (Ctrl+4)" Click="ViewMode_Click" />
                <Border Style="{StaticResource ToolSeparator}" />

                <ToggleButton x:Name="WireButton" Style="{StaticResource ToolToggle}" ToolTip="Wire frame (Ctrl+W)" Click="Wire_Click">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Wire}" />
                </ToggleButton>
                <ToggleButton x:Name="ModernButton" Style="{StaticResource ToolToggle}" ToolTip="Modern rendering: shadows, reflections, glow (Ctrl+M)" Click="Modern_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE706;" />
                </ToggleButton>
                <Button Style="{StaticResource ToolButton}" ToolTip="Ray trace this view (F9)" Click="RayTrace_Click">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RayTrace}" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- ============================================================ status bar -->
        <StatusBar DockPanel.Dock="Bottom" Padding="6,0">
            <StatusBarItem><TextBlock x:Name="StateStatus" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="ViewStatus" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="SelectionStatus" /></StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="WarningStatus" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </StatusBarItem>
        </StatusBar>

        <!-- ============================================================ work area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- left: element tree above the properties -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="120" />
                </Grid.RowDefinitions>
                <TreeView x:Name="Tree" BorderThickness="0" Padding="2,4" AllowDrop="True" />
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="Transparent" />
                <Border Grid.Row="1" Height="1" VerticalAlignment="Center" IsHitTestVisible="False" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <ui:PropertyGridView x:Name="Properties" Grid.Row="2" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" Background="Transparent" />
            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" IsHitTestVisible="False" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- right: the view, its tools and the timeline -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- the OpenGL view (a Windows Forms control) goes here -->
                <Border x:Name="ViewSlot" Background="Black" />

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,0,6,6" Width="84">
                        <TextBlock Style="{StaticResource PanelHeader}" Text="Move" />
                        <ui:NumberBox x:Name="MoveStep" Minimum="0.01" Maximum="100" Increment="0.1" Decimals="2" Value="1" ToolTip="Move step in scene units" />
                        <UniformGrid Columns="2" Margin="0,4,0,0">
                            <Button Style="{StaticResource ToolButton}" Tag="-1 0 0" ToolTip="Move -X" Click="Move_Click"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" /></Button>
                            <Button Style="{StaticResource ToolButton}" Tag="1 0 0" ToolTip="Move +X" Click="Move_Click"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" /></Button>
                            <Button Style="{StaticResource ToolButton}" Tag="0 1 0" ToolTip="Move +Y" Click="Move_Click"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" /></Button>
                            <Button Style="{StaticResource ToolButton}" Tag="0 -1 0" ToolTip="Move -Y" Click="Move_Click"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" /></Button>
                            <Button Style="{StaticResource ToolButton}" Tag="0 0 1" ToolTip="Move +Z (towards the viewer)" Click="Move_Click"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Towards}" /></Button>
                            <Button Style="{StaticResource ToolButton}" Tag="0 0 -1" ToolTip="Move -Z (away from the viewer)" Click="Move_Click"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Away}" /></Button>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource PanelHeader}" Text="Rotate" />
                        <ui:NumberBox x:Name="RotateStep" Minimum="0.1" Maximum="180" Increment="5" Decimals="1" Value="15" ToolTip="Rotation step in degrees" />
                        <UniformGrid x:Name="RotateButtons" Columns="2" Margin="0,4,0,0" />

                        <TextBlock Style="{StaticResource PanelHeader}" Text="Size" />
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource ToolButton}" Tag="1.1" ToolTip="Enlarge by 10 %" Click="Resize_Click"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Grow}" /></Button>
                            <Button Style="{StaticResource ToolButton}" Tag="0.9090909" ToolTip="Shrink by 10 %" Click="Resize_Click"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Shrink}" /></Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- timeline -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="6,4">
                    <DockPanel>
                        <ToggleButton x:Name="PlayButton" Style="{StaticResource ToolToggle}" ToolTip="Play / stop the animation (F5)" Click="Play_Click">
                            <TextBlock x:Name="PlayGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" />
                        </ToggleButton>
                        <ToggleButton x:Name="LoopButton" Style="{StaticResource ToolToggle}" ToolTip="Play in a loop">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EE;" />
                        </ToggleButton>
                        <TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" MinWidth="200" Margin="10,0,4,0" VerticalAlignment="Center" />
                        <Slider x:Name="Timeline" Minimum="0" Maximum="1000" Focusable="False" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
