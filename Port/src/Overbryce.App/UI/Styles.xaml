<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The editor's own icons and styles on top of WPF's Fluent theme. Every colour is a theme
        resource (DynamicResource), so light and dark switch without restarting.
    -->

    <!-- Windows 11 icon font, with the Windows 10 one as the fallback -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- element icons: line drawings on a 16 x 16 grid, drawn in the text colour -->
    <Geometry x:Key="Icon.Sphere">M1.5,8 a6.5,6.5 0 1 0 13,0 a6.5,6.5 0 1 0 -13,0 M1.5,8 a6.5,2.3 0 0 0 13,0</Geometry>
    <Geometry x:Key="Icon.Disk">M0.8,8.5 a7.2,3.6 0 1 0 14.4,0 a7.2,3.6 0 1 0 -14.4,0 M5.4,8.5 a2.6,1.25 0 1 0 5.2,0 a2.6,1.25 0 1 0 -5.2,0</Geometry>
    <Geometry x:Key="Icon.Cone">M5,3.5 a3,1.2 0 1 0 6,0 a3,1.2 0 1 0 -6,0 M5,3.5 L1.8,12.4 M11,3.5 L14.2,12.4 M1.8,12.4 a6.2,2.1 0 0 0 12.4,0</Geometry>
    <Geometry x:Key="Icon.Mesh">M1.5,4.5 C5,1.5 10,7.5 14.5,4.5 M1.5,8.5 C5,5.5 10,11.5 14.5,8.5 M1.5,12.5 C5,9.5 10,15.5 14.5,12.5 M1.5,4.5 V12.5 M6,4.1 V12.1 M10.2,4.9 V12.9 M14.5,4.5 V12.5</Geometry>
    <Geometry x:Key="Icon.PolyMesh">M8,1.5 L14.5,5.5 L12.5,13.5 L3.5,13.5 L1.5,5.5 Z M8,1.5 L8,8 M1.5,5.5 L8,8 L14.5,5.5 M3.5,13.5 L8,8 L12.5,13.5</Geometry>
    <Geometry x:Key="Icon.Box">M8,1.5 L14,4.5 V11.5 L8,14.5 L2,11.5 V4.5 Z M2,4.5 L8,7.5 L14,4.5 M8,7.5 V14.5</Geometry>
    <Geometry x:Key="Icon.Rectangle">M1.5,3.5 H14.5 V12.5 H1.5 Z</Geometry>
    <Geometry x:Key="Icon.Triangle">M8,2 L14.8,13.5 H1.2 Z</Geometry>
    <Geometry x:Key="Icon.Torus">M0.8,8 a7.2,4.7 0 1 0 14.4,0 a7.2,4.7 0 1 0 -14.4,0 M4.4,7.4 C6,9.6 10,9.6 11.6,7.4 M5.4,8.6 C7,7.1 9,7.1 10.6,8.6</Geometry>
    <Geometry x:Key="Icon.Light">M8,1.2 a4.6,4.6 0 0 0 -2.7,8.3 V11.4 H10.7 V9.5 A4.6,4.6 0 0 0 8,1.2 Z M5.7,13.2 H10.3 M6.6,15 H9.4</Geometry>
    <Geometry x:Key="Icon.Camera">M1,4.5 H10.5 V11.5 H1 Z M10.5,7 L15,4.8 V11.2 L10.5,9 M2.2,2.7 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0 M6.2,2.7 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0</Geometry>
    <Geometry x:Key="Icon.Group">M1.5,3 H6 L7.5,4.8 H14.5 V13 H1.5 Z M1.5,6.5 H14.5</Geometry>
    <!-- a key state: the key-frame diamond -->
    <Geometry x:Key="Icon.Scene">M8,1.5 L14.5,8 L8,14.5 L1.5,8 Z M8,5 L11,8 L8,11 L5,8 Z</Geometry>
    <!-- the animation: a film strip -->
    <Geometry x:Key="Icon.Animation">M1.5,2.5 H14.5 V13.5 H1.5 Z M4.2,2.5 V13.5 M11.8,2.5 V13.5 M1.5,5.2 H4.2 M1.5,8 H4.2 M1.5,10.8 H4.2 M11.8,5.2 H14.5 M11.8,8 H14.5 M11.8,10.8 H14.5</Geometry>
    <!-- a ray from the eye bouncing off a ball -->
    <Geometry x:Key="Icon.RayTrace">M8.2,10.6 a3.8,3.8 0 1 0 7.6,0 a3.8,3.8 0 1 0 -7.6,0 M1,2 L9.4,8.2 L4,14 M1,2 L3.4,2.3 M1,2 L1.9,4.2</Geometry>
    <!-- wire frame: a cube drawn with all its hidden edges -->
    <Geometry x:Key="Icon.Wire">M1.5,5 H11 V14.5 H1.5 Z M5,1.5 H14.5 V11 H5 Z M1.5,5 L5,1.5 M11,5 L14.5,1.5 M11,14.5 L14.5,11 M1.5,14.5 L5,11</Geometry>
    <!-- moving along Z: an arrow seen from behind (away) and from the front (towards the viewer) -->
    <Geometry x:Key="Icon.Towards">M2,8 a6,6 0 1 0 12,0 a6,6 0 1 0 -12,0 M6.6,8 a1.4,1.4 0 1 0 2.8,0 a1.4,1.4 0 1 0 -2.8,0</Geometry>
    <Geometry x:Key="Icon.Away">M2,8 a6,6 0 1 0 12,0 a6,6 0 1 0 -12,0 M4.8,4.8 L11.2,11.2 M11.2,4.8 L4.8,11.2</Geometry>
    <!-- grow and shrink: a square with arrows out of / into its corners -->
    <Geometry x:Key="Icon.Grow">M5,5 H11 V11 H5 Z M1.5,1.5 L4,4 M1.5,1.5 H4 M1.5,1.5 V4 M14.5,1.5 L12,4 M14.5,1.5 H12 M14.5,1.5 V4 M1.5,14.5 L4,12 M1.5,14.5 H4 M1.5,14.5 V12 M14.5,14.5 L12,12 M14.5,14.5 H12 M14.5,14.5 V12</Geometry>
    <Geometry x:Key="Icon.Shrink">M5.5,5.5 H10.5 V10.5 H5.5 Z M1.5,1.5 L4,4 M4,4 H2 M4,4 V2 M14.5,1.5 L12,4 M12,4 H14 M12,4 V2 M1.5,14.5 L4,12 M4,12 H2 M4,12 V14 M14.5,14.5 L12,12 M12,12 H14 M12,12 V14</Geometry>

    <!-- a line icon from the geometries above -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="StrokeThickness" Value="1.15" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- a glyph of the icon font -->
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MenuGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- flat icon buttons of the tool bars: no focus (keys keep going to the tree), a soft fill on hover -->
    <Style x:Key="ToolButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,6" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- a tool button that stays down: the accent colour while on -->
    <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- a text button of the tool bars (the view modes) -->
    <Style x:Key="ToolTextToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
        <Setter Property="Padding" Value="9,6" />
    </Style>

    <!-- small caption above a group of tool buttons -->
    <Style x:Key="PanelHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2,10,2,4" />
    </Style>

    <!-- a thin vertical line between groups of tool buttons -->
    <Style x:Key="ToolSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,6" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

</ResourceDictionary>
