<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Overbryce</AssemblyName>
    <RootNamespace>Overbryce.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Overbryce Animator</Product>
    <Version>2.2.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Overbryce.Core\Overbryce.Core.csproj" />
    <ProjectReference Include="..\Overbryce.Raytrace\Overbryce.Raytrace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- original 25x25 tool button bitmaps from DIP/SOURCE/BITMAPS -->
    <EmbeddedResource Include="Resources\Tools\*.bmp" LogicalName="Tools.%(Filename)%(Extension)" />
    <!-- written next to a Blender export; Blender runs it to build the .blend file -->
    <EmbeddedResource Include="Export\overbryce_blender.py" LogicalName="overbryce_blender.py" />
    <!-- the original sample animations and their textures ship next to the executable -->
    <Content Include="..\..\..\DIP\SCENES\**\*" LinkBase="Scenes" CopyToOutputDirectory="PreserveNewest" />
    <!-- new samples made for the port (samples/Lumina is generated by tools/Lumina) -->
    <Content Include="..\..\samples\**\*" Exclude="..\..\samples\**\*.md" LinkBase="Scenes" CopyToOutputDirectory="PreserveNewest" />
    <!-- the readme and the Lumina launcher of the published build (Properties/PublishProfiles/win-x64.pubxml) -->
    <None Include="Dist\*" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
