<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained Windows x64 build: a single Overbryce.exe (no .NET installation needed) with the
  Scenes folder (the 1998 samples and Lumina, with their bitmaps) next to it.
  From the Port folder:  dotnet publish src\Overbryce.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- no .pdb files of the referenced Overbryce.Core next to the exe -->
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\out\dist\Overbryce\</PublishDir>
  </PropertyGroup>
</Project>
