<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the "Lumina" sample animation: generates the procedural textures and writes
    samples/Lumina/Lumina.ani through Overbryce.Core. Run it with "dotnet run" and the project path tools/Lumina
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lumina</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Overbryce.Core\Overbryce.Core.csproj" />
  </ItemGroup>

</Project>
